# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings -> Database -> Connection string (direct connection, used by Drizzle)
DATABASE_URL=

# Public origin, used to build PayMongo success/cancel return URLs.
# Local: http://localhost:3000. Falls back to VERCEL_URL on preview deploys.
NEXT_PUBLIC_APP_URL=

# PayMongo dashboard -> Developers -> API keys. Sigla's OWN coach-subscription
# billing only; no client funds ever pass through this account.
PAYMONGO_SECRET_KEY=
# PayMongo webhook secret, returned when the webhook endpoint is registered.
# Endpoint URL: <NEXT_PUBLIC_APP_URL>/api/webhooks/paymongo
PAYMONGO_WEBHOOK_SECRET=
